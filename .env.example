# ===========================================================================
# .env.example — Environment configuration for jobctl Docker Daemon & Telegram
# Copy this file to .env (`cp .env.example .env`) and fill in your values.
# .env is git-ignored so your credentials are never exposed in code or commits.
# ===========================================================================

# --- 1. Daily / Weekday Schedule Configuration (for `jobctl daemon` / Docker -d) ---
# IANA timezone name (default: Asia/Dhaka)
TZ=Asia/Dhaka
# 24-hour time of day to run the job search (default: 11:00 for 11:00 AM)
JOBCTL_SCHEDULE_TIME=11:00
# Days to run: "daily" (or "*"), "weekdays", "weekends", or comma-separated days e.g. "sun,mon,tue,wed,thu"
JOBCTL_SCHEDULE_DAYS=daily
# Set to true to also execute one search immediately when the container starts
JOBCTL_RUN_ON_STARTUP=false

# --- 2. Telegram Bot Notification Credentials (Messages & Links Only, No Files) ---
# Create a bot via @BotFather on Telegram to get TELEGRAM_BOT_TOKEN
# Message @userinfobot (or call /getUpdates) to get your numeric TELEGRAM_CHAT_ID
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Send a short summary message even when 0 new jobs matched today
TELEGRAM_NOTIFY_ON_EMPTY=true

# --- 3. Optional Adzuna Aggregator API Credentials ---
# Register at https://developer.adzuna.com/ and set [sources.adzuna] enabled = true in jobctl.toml
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY_CODE=us
